# Copy to .env (windows\install.ps1 creates it automatically).
# Everything else (bot token, cookies, limits...) is configured in the admin panel.

# Random string; encrypts the tokens/cookies saved in the panel. Don't lose or change it.
SECRET_KEY=change-me

# 127.0.0.1:8000 behind Caddy/IIS, or 0.0.0.0:80 to serve directly.
HOST=127.0.0.1
PORT=8000

# 1 when running behind Cloudflare Tunnel / proxy: visitor IP is read from CF-Connecting-IP.
# Keep HOST=127.0.0.1 in that case so nobody can reach the app directly and fake the header.
BEHIND_CLOUDFLARE=0

# 1 when the site is served over HTTPS (session cookie gets the Secure flag).
SECURE_COOKIES=1

# Optional: create the admin account on first start instead of the /admin/setup page.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Optional: where the database and temporary downloads live (default: .\data)
# DATA_DIR=D:\save-data

LOG_LEVEL=INFO
